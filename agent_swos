ENV_PREFIX = "SWOS_"


def _default_state_dir():
    """Counter snapshots for rates. Same default as before, except that inside a
    Checkmk site (where /var/lib/check_mk_agent is not writable) it is ~/var."""
    if os.environ.get("MK_VARDIR"):
        return os.path.join(os.environ["MK_VARDIR"], "mikrotik_swos")
    if os.environ.get("OMD_ROOT"):
        return os.path.join(os.environ["OMD_ROOT"], "var", "check_mk", "agent_swos")
    return "/var/lib/check_mk_agent/mikrotik_swos"


